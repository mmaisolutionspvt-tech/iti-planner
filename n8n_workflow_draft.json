{
  "name": "Firstflight Booking Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "firstflight-booking",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "id": "webhook-booking",
      "name": "Booking Webhook Receiver"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-email",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": "isNotEmpty"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        240
      ],
      "id": "if-valid-booking",
      "name": "Is Valid Booking?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"Firstflight Travels <onboarding@resend.dev>\",\n  \"to\": [\"{{ $json.email }}\"],\n  \"subject\": \"✈️ Your Booking Confirmation - {{ $json.itemData.name }}\",\n  \"html\": \"<div style='font-family: sans-serif; max-width: 600px; margin: auto; padding: 20px; border: 1px solid #eee; border-radius: 10px;'><h2 style='color: #121619; border-bottom: 2px solid #D4B15A; padding-bottom: 10px;'>Firstflight Booking Confirmation</h2><p>Hi <strong>{{ $json.name }}</strong>,</p><p>Your booking for <strong>{{ $json.itemData.name }}</strong> ({{ $json.itemType }}) has been successfully confirmed!</p><table style='width: 100%; border-collapse: collapse; margin: 20px 0;'><tr style='background: #f9f9f9;'><td style='padding: 10px; border: 1px solid #eee;'><strong>From</strong></td><td style='padding: 10px; border: 1px solid #eee;'>{{ $json.itemData.from || $json.itemData.city || 'N/A' }}</td></tr><tr><td style='padding: 10px; border: 1px solid #eee;'><strong>To</strong></td><td style='padding: 10px; border: 1px solid #eee;'>{{ $json.itemData.to || 'N/A' }}</td></tr><tr style='background: #f9f9f9;'><td style='padding: 10px; border: 1px solid #eee;'><strong>Dates</strong></td><td style='padding: 10px; border: 1px solid #eee;'>{{ $json.itemData.fromDate }} to {{ $json.itemData.toDate }}</td></tr><tr><td style='padding: 10px; border: 1px solid #eee;'><strong>Total Paid</strong></td><td style='padding: 10px; border: 1px solid #eee;'>INR {{ $json.itemData.price_inr }}</td></tr></table><p>Download your official PDF ticket directly here: <a href='{{ $json.pdf_url }}' style='color: #D4B15A; font-weight: bold;'>Get Ticket PDF</a></p><p>Have a wonderful journey!</p><hr style='border: 0; border-top: 1px solid #eee; margin-top: 30px;'><p style='font-size: 11px; color: #888; text-align: center;'>Firstflight Travels Private Ltd. 1800-FF-TRAVELS</p></div>\",\n  \"attachments\": [\n    {\n      \"filename\": \"Firstflight_Ticket_{{ $json.userId }}.pdf\",\n      \"path\": \"{{ $json.pdf_url }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        60
      ],
      "id": "resend-email",
      "name": "Send Email (Resend)",
      "credentials": {
        "httpHeaderAuth": {
          "id": "resend-api-key",
          "name": "Resend API Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID || 'YOUR_PHONE_NUMBER_ID' }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Hi {{ $json.name }},\\n\\nYour Firstflight Booking is CONFIRMED!\\n\\nItem: {{ $json.itemData.name }}\\nPrice: INR {{ $json.itemData.price_inr }}\\nPDF Ticket URL: {{ $json.pdf_url }}\\n\\nWish you a safe journey!\" \n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        200
      ],
      "id": "whatsapp-meta",
      "name": "WhatsApp (Meta API)",
      "credentials": {
        "httpHeaderAuth": {
          "id": "whatsapp-meta-auth",
          "name": "Meta Cloud API Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $env.TWILIO_ACCOUNT_SID || 'YOUR_TWILIO_SID' }}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "sendBody": true,
        "specifyBody": "formUrlEncoded",
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "From",
              "value": "={{ $env.TWILIO_FROM_NUMBER || '+1234567890' }}"
            },
            {
              "name": "To",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "Body",
              "value": "=Firstflight: Booking confirmed for {{ $json.itemData.name }} (INR {{ $json.itemData.price_inr }}). Ticket URL: {{ $json.pdf_url }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        340
      ],
      "id": "twilio-sms",
      "name": "SMS (Twilio)",
      "credentials": {
        "httpBasicAuth": {
          "id": "twilio-auth",
          "name": "Twilio Credentials"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "list",
          "cachedResultName": "Firstflight Bookings"
        },
        "sheetName": {
          "__rl": true,
          "value": "Bookings",
          "mode": "list",
          "cachedResultName": "Bookings"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ new Date().toISOString() }}",
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Item Type": "={{ $json.itemType }}",
            "Provider": "={{ $json.itemData.name }}",
            "Amount": "={{ $json.itemData.price_inr }}",
            "PDF URL": "={{ $json.pdf_url }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        480,
        480
      ],
      "id": "google-sheets-log",
      "name": "Log to Google Sheets",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-oauth",
          "name": "Google Sheets OAuth"
        }
      }
    }
  ],
  "connections": {
    "Booking Webhook Receiver": {
      "main": [
        [
          {
            "node": "Is Valid Booking?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Valid Booking?": {
      "main": [
        [
          {
            "node": "Send Email (Resend)",
            "type": "main",
            "index": 0
          },
          {
            "node": "WhatsApp (Meta API)",
            "type": "main",
            "index": 0
          },
          {
            "node": "SMS (Twilio)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log to Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  }
}

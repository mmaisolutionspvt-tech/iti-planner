# FirstFlight AI Trip Planner Environment Setup
# Copy this file to .env in react-app/ and backend/ and supply your API keys.

VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_XWEATHER_CLIENT_ID=your_xweather_client_id_here
VITE_XWEATHER_CLIENT_SECRET=your_xweather_client_secret_here
VITE_OPENWEATHER_KEY=your_openweather_api_key_here
VITE_BACKEND_URL=http://localhost:5000
